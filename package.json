{
  "name": "labeling-system",
  "version": "1.0.0",
  "private": true,
  "description": "Mill Label Printing System for Sri Lankan mill businesses",
  "author": "Joel Nithushan",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "seed": "ELECTRON_RUN_AS_NODE=1 electron scripts/seed.cjs",
    "build": "tsc && vite build",
    "electron:build": "npm run build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:db": "INCLUDE_DB_TESTS=1 vitest run electron/__tests__",
    "test:all": "INCLUDE_DB_TESTS=1 vitest run"
  },
  "build": {
    "appId": "com.millbusiness.labelingsystem",
    "productName": "Mill Label System",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mill Label System"
    },
    "portable": {
      "artifactName": "MillLabelSystem-Portable.exe"
    }
  },
  "dependencies": {
    "@fontsource/noto-sans-tamil": "^5.2.7",
    "better-sqlite3": "^11.10.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.6.0"
  }
}
